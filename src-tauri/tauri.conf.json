{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gacha Hub",
  "version": "0.1.0",
  "identifier": "com.gachahub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gacha Hub",
        "width": 1150,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/images/*", "$APPCACHE/icons/*", "$APPCACHE/art/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/hub.json"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
